name: Auto Approve and Merge Jules PRs

on:
  pull_request_target:
    types:
      - opened
      - synchronize
      - reopened

jobs:
  auto-approve-and-merge:
    # PR 작성자 ID에 jules가 포함되어 있는지 확인 (대소문자 미구분)
    if: contains(github.event.pull_request.user.login, 'jules') || contains(github.event.pull_request.user.login, 'Jules') || contains(github.event.pull_request.user.login, 'google-jules')
    runs-on: ubuntu-latest
    permissions:
      contents: write
      pull-requests: write

    steps:
      - name: Approve and Merge PR
        run: |
          gh pr review "$PR_URL" --approve --body "Auto-approved by GitHub Actions."
          gh pr merge "$PR_URL" --squash --auto --delete-branch
        env:
          PR_URL: ${{ github.event.pull_request.html_url }}
          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
